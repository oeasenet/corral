# Copy to .env and fill in the three required values. Never commit .env.

# ---------------------------------------------------------------- required ---
# GitHub organization (or user) the runners register to. To register to a single
# repository instead, set RUNNER_REGISTER_TO=owner/repo in docker-compose.yml.
GITHUB_OWNER=oeasenet

# PAT able to manage self-hosted runners for that owner:
#   classic PAT:       admin:org (organization runners)  /  repo (repository runners)
#   fine-grained PAT:  organization permission "Self-hosted runners: Read and write"
GITHUB_PAT=

# Dashboard password (user: admin). Generate with: openssl rand -hex 16
ADMIN_PASSWORD=

# ------------------------------------------------- initial runner settings ---
# Only used on the very first start; afterwards change them in the dashboard.
RUNNER_COUNT=2
RUNNER_LABELS=
RUNNER_IMAGE=ghcr.io/oeasenet/gha-docker-runner/runner:latest

# Credentials for pulling the runner image while its GHCR package is private
# (a PAT with read:packages). Leave empty if the package is public.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ------------------------------------------------------------------- misc ---
# Controller image tag: latest, main, sha-<commit> or a release such as 1.0.0
IMAGE_TAG=latest

# Dashboard bind address/port on this host (127.0.0.1 = local only).
BIND_ADDR=127.0.0.1
PORT=8080

TZ=UTC
