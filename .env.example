# Copy to .env and fill in GITHUB_PAT. Never commit .env.

# ---------------------------------------------------------------- required ---
# GitHub organization (or user) the runners register to. To register to a single
# repository instead, set RUNNER_REGISTER_TO=owner/repo in docker-compose.yml.
GITHUB_OWNER=your-org

# PAT able to manage self-hosted runners for that owner:
#   classic PAT:       admin:org (organization runners)  /  repo (repository runners)
#   fine-grained PAT:  organization permission "Self-hosted runners: Read and write"
GITHUB_PAT=

# --------------------------------------------------------------- dashboard ---
# Empty = no authentication (the default; fine behind a firewall). Set a password
# to require HTTP basic auth (user: admin), e.g. from: openssl rand -hex 16
ADMIN_PASSWORD=

# Bind address/port on this host: 0.0.0.0 = reachable from your network, 127.0.0.1 = local only.
BIND_ADDR=0.0.0.0
PORT=8080

# ------------------------------------------------- initial runner settings ---
# Only used on the very first start; afterwards change them in the dashboard.
RUNNER_COUNT=2
RUNNER_LABELS=
# Runtime environment of the first pool: ubuntu (26.04), debian (13) or minideb (Debian 13).
# More pools (e.g. Debian next to Ubuntu) are added in the dashboard.
RUNNER_RUNTIME=ubuntu
# Optional image override for that pool (blank = ghcr.io/oeasenet/corral/runner:<runtime>).
RUNNER_IMAGE=

# ---------------------------------------------------------------- updates ---
# Pull pool images every hour and replace idle runners built from an older image.
# CI publishes new images within hours of an actions/runner release.
AUTO_UPDATE=true
UPDATE_CHECK_INTERVAL=1h

# Credentials for pulling runner images from a private registry (for GHCR: a PAT
# with read:packages). Leave empty for public images.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ------------------------------------------------------------------- misc ---
# corral image tag: latest, main, sha-<commit> or a release such as 1.0.0
IMAGE_TAG=latest

TZ=UTC
