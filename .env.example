# Copy to .env and fill in the three required values. Never commit .env.

# ---------------------------------------------------------------- required ---
# GitHub organization (or user) whose runners these are. The PAT must be able
# to manage its self-hosted runners:
#   classic PAT:       admin:org (org runners)  /  repo (repository runners)
#   fine-grained PAT:  organization permission "Self-hosted runners: Read and write"
GITHUB_OWNER=oeasenet
GITHUB_PAT=

# Shared secret between the runners and the KMS. Generate with: openssl rand -hex 32
KMS_AUTH_TOKEN=

# ----------------------------------------------------------------- runners ---
# Number of runner containers to run on this host.
RUNNER_REPLICAS=2

# Where runners register: blank = the organization above (org-level runners),
# or owner/repo for repository-level runners, e.g. oeasenet/platform
RUNNER_REGISTER_TO=

# Runner names become <prefix>-<container id>, e.g. oease-3f2a1b9c0d4e
RUNNER_NAME_PREFIX=oease

# Extra labels, comma-separated. self-hosted, Linux and X64/ARM64 are always added.
RUNNER_LABELS=

# Runner group for org-level runners (blank = Default).
RUNNER_GROUP=

# true = each registration serves exactly one job, then the container restarts
# with a clean state. Pair with RUNNER_DISABLE_UPDATE=true.
RUNNER_EPHEMERAL=false

# true = never self-update the runner binary; rely on image updates instead.
RUNNER_DISABLE_UPDATE=false

# Seconds a stopping runner waits for its current job before shutting down.
RUNNER_GRACEFUL_STOP_TIMEOUT=900

# Extra apt packages installed when a runner starts, comma-separated.
ADDITIONAL_PACKAGES=

# ------------------------------------------------------------------- misc ---
# Image tag to deploy: latest, main, sha-<commit>, or a release such as 1.0.0
IMAGE_TAG=latest

# KMS dashboard bind address/port on this host (127.0.0.1 = local only).
KMS_BIND_ADDR=127.0.0.1
KMS_PORT=3000

TZ=UTC
